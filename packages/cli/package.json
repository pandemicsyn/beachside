{
  "name": "@beachside/cli",
  "version": "0.8.0",
  "private": false,
  "type": "module",
  "description": "Agent-first command line for creating and managing Beachside sandboxes.",
  "bin": {
    "beachside": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/main.ts --target node --format esm --outdir dist --external beachside --external @beachside/adapter --external zod"
  },
  "dependencies": {
    "@beachside/adapter": "workspace:*",
    "beachside": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@beachside/boat": "workspace:*",
    "@beachside/boxd": "workspace:*",
    "@beachside/daytona": "workspace:*",
    "@beachside/e2b": "workspace:*",
    "@beachside/runloop": "workspace:*",
    "@beachside/modal": "workspace:*",
    "@beachside/vercel": "workspace:*",
    "@beachside-internal/provider-fake": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandemicsyn/beachside.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/pandemicsyn/beachside/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
