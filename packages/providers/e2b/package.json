{
  "name": "@beachside/e2b",
  "version": "0.12.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/index.ts --target node --format esm --outdir dist --external @beachside/adapter --external e2b --external zod && tsc -p tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --outDir dist && bun ../../../scripts/rewrite-declarations.mjs"
  },
  "dependencies": {
    "@beachside/adapter": "workspace:*",
    "e2b": "2.63.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "beachside": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandemicsyn/beachside.git",
    "directory": "packages/providers/e2b"
  },
  "bugs": {
    "url": "https://github.com/pandemicsyn/beachside/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Official E2B adapter for Beachside.",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.19"
  }
}
