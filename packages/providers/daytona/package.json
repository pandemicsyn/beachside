{
  "name": "@beachside/daytona",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "rm -rf dist && bun build src/index.ts --target node --format esm --outdir dist --external @beachside/adapter --external zod && tsc -p tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --outDir dist && bun ../../../scripts/rewrite-declarations.mjs && bun ../../../scripts/package-daytona-declarations.mjs"
  },
  "dependencies": {
    "zod": "4.6.5",
    "@beachside/adapter": "workspace:*"
  },
  "devDependencies": {
    "beachside": "workspace:*",
    "@beachside-internal/provider-spi": "workspace:*"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandemicsyn/beachside.git",
    "directory": "packages/providers/daytona"
  },
  "bugs": {
    "url": "https://github.com/pandemicsyn/beachside/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Official Daytona adapter for Beachside.",
  "types": "./dist/index.d.ts"
}
